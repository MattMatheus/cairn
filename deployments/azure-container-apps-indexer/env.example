# Container App runtime
CAIRN_INDEXER_WORKSPACE_ID=cairn:workspace:pod-a
CAIRN_STORAGE_ACCOUNT=examplecairn
CAIRN_STORAGE_CONTAINER=pod-a
CAIRN_STORAGE_PREFIX=
CAIRN_POSTGRES_DSN=keyvault-or-aca-secret-reference
CAIRN_AUTH_AUDIENCE=api://cairn-indexer
CAIRN_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
CAIRN_LOG_LEVEL=info

# Cairn client config values
CAIRN_REMOTE_INDEX_URL=https://cairn-indexer.example.azurecontainerapps.io
CAIRN_REMOTE_INDEX_AUDIENCE=api://cairn-indexer
CAIRN_REMOTE_INDEX_TENANT_ID=00000000-0000-0000-0000-000000000000
